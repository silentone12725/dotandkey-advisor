# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider: "nim" | "ollama" | "openai" | "google"
LLM_PROVIDER=nim

# NIM (dev/testing — Qwen3.5-122B-A10B)
NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=qwen/qwen3.5-122b-a10b

# Ollama (local fallback — Qwen3.5-4B)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b

# OpenAI-compatible fallback
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini fallback
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxx
GOOGLE_MODEL=gemini-2.0-flash

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev: localhost  |  Docker Compose: overridden to "falkordb" in compose file
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── FalkorDB ─────────────────────────────────────────────────────────────────
# Local dev: localhost  |  Docker Compose: overridden to "falkordb" in compose file
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=dotandkey

# ── Weather ───────────────────────────────────────────────────────────────────
TOMORROW_API_KEY=xxxxxxxxxxxxxxxxxxxx

# ── Backend ───────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API
# In prod: https://www.dotandkey.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://www.dotandkey.com

# Token budget per LLM call
MAX_INPUT_TOKENS=2000
MAX_OUTPUT_TOKENS=300

# Profile TTL in seconds: 60 days
PROFILE_TTL_SECONDS=5184000

# Session TTL in seconds: 30 minutes
SESSION_TTL_SECONDS=1800

# History TTL in seconds: 365 days
HISTORY_TTL_SECONDS=31536000

# ── Security ──────────────────────────────────────────────────────────────────
# HMAC key for profile tokens. /session/init issues a token binding the browser
# to its profile id; every other endpoint verifies it. REQUIRED in deployment —
# when unset the server mints a random key per process, so tokens stop working
# on restart. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
PROFILE_TOKEN_SECRET=

# Migration escape hatch. "true" keeps accepting a bare X-Profile-Id, which is
# the hole profile tokens close. Only enable while an old widget is still
# deployed, and turn it off once clients have refreshed.
ALLOW_UNSIGNED_PROFILE_ID=false

# Shared secret from the Shopify webhook config. /webhook/order verifies the
# X-Shopify-Hmac-Sha256 signature and refuses every request (503) until this is
# set — without it anyone could forge purchase history for any profile.
SHOPIFY_WEBHOOK_SECRET=

# Public origin of THIS backend, used to build the widget <script src> injected
# by the reverse proxy. Must be set in deployment: otherwise the value is taken
# from the request's Host header, which a client can spoof.
PUBLIC_BASE_URL=

# Set true only when running behind a proxy that overwrites X-Forwarded-For.
# When false the client's real socket address is used for geo lookup, so a
# caller can't spoof their location or burn the ip-api.com rate limit.
TRUST_PROXY_HEADERS=false
